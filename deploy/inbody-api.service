[Unit]
Description=InBody Tech-Master FastAPI
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/inbody-app
EnvironmentFile=/home/ubuntu/inbody-app/.env
Environment=PYTHONPATH=/home/ubuntu/inbody-app
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/inbody-app/.venv/bin/uvicorn src.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
