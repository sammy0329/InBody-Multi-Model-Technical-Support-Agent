[Unit]
Description=InBody Tech-Master Streamlit UI
After=network.target inbody-api.service
Requires=inbody-api.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/InBody-Multi-Model-Technical-Support-Agent
Environment=PYTHONPATH=/home/ubuntu/InBody-Multi-Model-Technical-Support-Agent
Environment=API_BASE_URL=http://localhost:8000/api/v1
ExecStart=/home/ubuntu/InBody-Multi-Model-Technical-Support-Agent/.venv/bin/streamlit run ui/app.py --server.port=8501 --server.address=0.0.0.0 --server.headless=true --browser.gatherUsageStats=false
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
